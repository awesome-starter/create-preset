{
  "name": "preset-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/sync-schema.mjs && next dev --port 3300",
    "build": "node scripts/sync-schema.mjs && NEXT_OUTPUT=export NEXT_DIST_DIR=.next-static next build && pnpm run build:search",
    "build:search": "node ./scripts/build-search-index.mjs",
    "build:static": "pnpm run build",
    "start": "pnpm run start:static",
    "start:static": "pnpm dlx serve .next-static --listen 4300",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bassist/utils": "^0.17.0",
    "@blackwork/docs": "^0.6.0",
    "@blackwork/search": "^0.1.1",
    "blackwork": "^0.14.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
