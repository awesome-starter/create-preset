{
  "name": "create-preset",
  "version": "1.0.1",
  "description": "A unified CLI for creating and applying development presets.",
  "author": "chengpeiquan <chengpeiquan@chengpeiquan.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "homepage": "https://preset.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preset-cli/create-preset.git"
  },
  "bugs": {
    "url": "https://github.com/preset-cli/create-preset/issues"
  },
  "keywords": [
    "create-preset",
    "preset",
    "template",
    "scaffold",
    "cli",
    "rust"
  ],
  "bin": {
    "create-preset": "./bin/preset.js",
    "preset": "./bin/preset.js"
  },
  "files": [
    "bin",
    "binaries",
    "schema"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:rust": "cargo build --release",
    "test": "cargo test",
    "test:package": "node scripts/test-package.js",
    "test:release": "node --test scripts/release.test.mjs",
    "dev:docs": "pnpm --dir docs dev",
    "build:docs": "pnpm --dir docs build",
    "test:docs": "pnpm --dir docs test",
    "lint:docs": "pnpm --dir docs lint"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "semver": "7.8.5"
  }
}
